# Copy this file to .env.local for local development.
# In Vercel, add the same names under Project > Settings > Environment Variables.

# Required for the contact form to send email. Create one at resend.com/api-keys
RESEND_API_KEY=

# Optional. Where contact form messages are delivered.
# Defaults to formInbox in src/content/site.ts
CONTACT_TO_EMAIL=

# Optional. The sender shown on those emails. The domain must be verified in Resend.
# Defaults to: CNG Synergy Website <website@contact.cngsynergy.com>
CONTACT_FROM_EMAIL=
